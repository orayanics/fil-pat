{
  "name": "fil-pat",
  "version": "1.2.1",
  "description": "Filipino Phonological Assessment Tool Application",
  "author": "UST College of Rehabilitation Sciences",
  "private": true,
  "scripts": {
    "dev": "nodemon",
    "dev:next": "next dev --turbopack",
    "dev:websocket": "nodemon --config nodemon.websocket.json",
    "fullstack": "concurrently \"npm run dev:next\" \"npm run dev:websocket\"",
    "build": "next build && tsc --project tsconfig.server.json",
    "build:server": "tsc --project tsconfig.server.json",
    "start": "node dist/server.js",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/lib/database/seed.ts",
    "db:seed:templates": "tsx scripts/seedTemplates.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset && npm run db:seed",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev:electron": "npm run build:electron && electron dist-electron/main.js",
    "prebuild:electron": "node scripts/prebuild-electron.js",
    "package:electron": "npm run package:win",
    "package:win": "npm run prebuild:electron && npm run build && npm run build:electron && electron-builder --win --x64",
    "package:mac": "npm run prebuild:electron && npm run build && npm run build:electron && electron-builder --mac",
    "package:all": "npm run prebuild:electron && npm run build && npm run build:electron && electron-builder --mac --win",
    "dist": "npm run prebuild:electron && npm run build && npm run build:electron && electron-builder",
    "dist:portable": "npm run prebuild:electron && npm run build && npm run build:electron && electron-builder --win portable",
    "dist:installer": "npm run prebuild:electron && npm run build && npm run build:electron && electron-builder --win nsis",
    "generate:icons": "node scripts/generate-icon.cjs",
    "clean:dist": "rimraf release dist-electron dist",
    "clean:fresh": "rimraf node_modules dist dist-electron release"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.2.0",
    "@mui/joy": "^5.0.0-beta.52",
    "@prisma/client": "^5.22.0",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.2.0",
    "canvg": "^4.0.3",
    "cookie": "^0.7.2",
    "dompurify": "^3.3.0",
    "jsonwebtoken": "^9.0.2",
    "next": "^15.5.7",
    "nodemon": "^3.1.10",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-to-pdf": "^2.0.1",
    "ws": "^8.18.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "15.3.5",
    "png2icons": "^2.0.1",
    "png-to-ico": "^3.0.1",
    "prisma": "^5.22.0",
    "rimraf": "^5.0.10",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.ust.filpat",
    "productName": "FIL-PAT",
    "asar": true,
    "asarUnpack": [
      "node_modules/.prisma/**",
      "node_modules/@prisma/client/**",
      "**/*.node"
    ],
    "beforeBuild": "scripts/before-build.js",
    "afterPack": "./electron-builder-afterPack.js",
    "npmRebuild": false,
    "files": [
      ".next/**/*",
      "dist/**/*",
      "dist-electron/**/*",
      "prisma/**/*",
      "public/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/@img/sharp-linux-*/**/*"
    ],
    "extraResources": [
      {
        "from": "prisma",
        "to": "prisma"
      },
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma"
      },
      {
        "from": "node_modules/@prisma/client",
        "to": "node_modules/@prisma/client"
      },
      {
        "from": "node_modules/@prisma/engines",
        "to": "node_modules/@prisma/engines"
      },
      {
        "from": ".next",
        "to": ".next"
      },
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "public",
        "to": "public"
      }
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "directories": {
      "output": "release",
      "buildResources": "assets/icons"
    },
    "mac": {
      "icon": "icon.icns",
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-${os}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "scripts/entitlements.mac.plist",
      "entitlementsInherit": "scripts/entitlements.mac.plist",
      "identity": null,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-${os}.${ext}",
      "requestedExecutionLevel": "requireAdministrator",
      "forceCodeSigning": false,
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Filipino Phonological Assessment Tool",
      "include": "scripts/installer.nsh"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "icon.icns"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    }
  }
}
