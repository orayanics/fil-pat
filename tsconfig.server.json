{
  "compilerOptions": {
    "target": "es2019",
    "lib": ["es2019"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "isolatedModules": false,
    "noEmit": false,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "server.ts", 
    "websocket.ts",
    "src/lib/database/seed.ts",
    "src/lib/database/client.ts",
    "src/lib/auth/auth.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
